<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-black text-white">

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card bg-black border border-secondary p-4 rounded-4" style="max-width: 450px; width: 100%;">
        
        <div class="text-center mb-4 fs-1">&#x1D54F;</div>

        <h3 class="text-white fw-bold mb-4">Change your password</h3>

        <form action="/changePassword" method="post" id="changePasswordForm">
            
               <div class="form-floating mb-3">
                <input type="password" name="oldpassword" class="form-control bg-black text-white border-secondary shadow-none" id="oldpassword" placeholder="Old Password" required>
                <label for="oldpassword" class="text-secondary">Old Password</label>
            </div>

            <div class="form-floating mb-3">
                <input type="password" name="password" class="form-control bg-black text-white border-secondary shadow-none" id="password" placeholder="New Password" required>
                <label for="password" class="text-secondary">New Password</label>
            </div>

            <div class="form-floating mb-4">
                <input type="password" name="cnfmpassword" class="form-control bg-black text-white border-secondary shadow-none" id="cnfmpassword" placeholder="Confirm Password" required>
                <label for="cnfmpassword" class="text-secondary">Confirm Password</label>
            </div>
           
<div id="error" style="color: red;">

</div>         


            
                
                

            <button type="submit" class="btn btn-light w-100 rounded-pill fw-bold py-2 mt-2">
                Change Password
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="/login" class="text-decoration-none text-primary small">Back to login</a>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

<script src="/js/changePassword.js">
   

    


</script>

</body>
</html>
