<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body>

    <div class="container-fluid bg-black min-vh-100 py-3">
        <div class="row justify-content-center">


    <div class="col-2 col-md-3 d-none d-sm-block">
                <%- include('navbar.ejs') %>
            </div>




            <div class="col-8 ">


                <% if ((retweets && retweetedTweetUserDetails) && retweetedTweetDetails) {%>

                    <%for(let i=0;i< retweets.length ; i++){%>
                        <div class="card bg-black text-white mb-0 border-bottom border-secondary rounded-0 shadow-none">
                            <div class="card-body">
                                <div class="d-flex">

                                    <!-- Avatar -->
                                    <div class="flex-shrink-0">
                                        <h6>You reposted</h6>
                                        <a href="/userprofile/<%= retweetedTweetUserDetails[i].user_id%>">
                                            <img src="/<%= retweetedTweetUserDetails[i].profile_path %>" alt="User"
                                                class="rounded-circle border border-dark" width="50" height="50">
                                        </a>
                                    </div>

                                    <!-- Content Area -->
                                    <div class="flex-grow-1 ms-3">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <h6 class="card-title mb-1">
                                                <span class="fw-bold">
                                                    <%= retweetedTweetUserDetails[i].user_name %>
                                                </span>
                                                <span class="text-secondary fw-normal small ms-1">
                                                   
                                                        @<%= retweetedTweetUserDetails[i].user_name.replace(/\s+/g, ''
                                                            ).toLowerCase() %> · 
                                                            <span class="time" createdAt="<%= retweets[i].created_at %>"></span>
                                                </span>
                                            </h6>

                                            <!-- Delete Icon pushed to right with ms-auto -->
                                            <div class="action-item delete">
                                                <a href="/tweet/<%= retweets[i].tweet_id %>"
                                                    class="text-secondary text-decoration-none">
                                                    <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
                                                        <path
                                                            d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1H2.5zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5zM8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5zm3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0z" />
                                                    </svg>
                                                </a>
                                            </div>
                                        </div>

                                        <p class="card-text mb-2 mt-1 text-break fs-6 fs-md-5">
                                            <%= retweetedTweetDetails[i].content %>
                                        </p>

                                        <!-- Media Path -->
                                        <% if (retweetedTweetDetails[i].media_path) { %>
                                            <div class="mt-2">
                                                <img src="/<%= retweetedTweetDetails[i].media_path %>"
                                                    class="img-fluid rounded-4 border border-secondary"
                                                    alt="Tweet Image">
                                            </div>
                                            <% } %>

                                                <!-- Engagement Actions -->
                                                <div class="tweet-actions d-flex justify-content-between text-secondary mt-3 w-100"
                                                    style="max-width: 425px;">
                                                    <!-- Reply -->
                                                    <span class="action-item reply" title="Reply">
                                                        <i class="far fa-comment comment"
                                                            tweet_id="<%= retweetedTweetDetails[i].tweet_id %>"></i>
                                                    </span>
                                                    <!-- Retweet -->
                                                    <span class="action-item " title="Retweet">
                                                        <i class="fas fa-retweet retweet"
                                                            tweet_id="<%= retweetedTweetDetails[i].tweet_id %>"></i>
                                                    </span>
                                                    <!-- Like -->
                                                    <span class="action-item " title="Like">
                                                        <i class="far fa-heart like"
                                                            tweet_id="<%= retweetedTweetDetails[i].tweet_id %>"></i>
                                                        <%=retweetedTweetDetails[i].likes%>
                                                    </span>
                                                </div>

                                    </div>
                                </div>
                            </div>
                        </div>


                        <%}%>
                            <%}%>



                                <% if (tweets && tweets.length>0 ) {%>
                                    <% for(let i=0; i < tweets.length; i++) { %>
                                        <!-- Dark Card with subtle border -->
                                        <div
                                            class="card bg-black text-white mb-0 border-bottom border-secondary rounded-0 shadow-none">
                                            <div class="card-body">
                                                <div class="d-flex">

                                                    <!-- Avatar -->
                                                    <div class="flex-shrink-0">
                                                        <a href="/profile">
                                                            <img src="/<%= tweets[i].profile_pic %>" alt="User"
                                                                class="rounded-circle border border-dark" width="50"
                                                                height="50">
                                                        </a>
                                                    </div>

                                                    <!-- Content Area -->
                                                    <div class="flex-grow-1 ms-3">
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <h6 class="card-title mb-1">
                                                                <span class="fw-bold">
                                                                    <%= tweets[i].user_name %>
                                                                </span>
                                                                <span class="text-secondary fw-normal small ms-1" >
                                                           

                                                                        @<%= tweets[i].user_name.replace(/\s+/g, ''
                                                                            ).toLowerCase() %> ·
                                                                            <span class="time" createdAt="<%= tweets[i].created_at %>"> </span>
                                                                          
                                                                </span>
                                                            </h6>


                                                            <!-- Delete Icon pushed to right with ms-auto -->
                                                            <div class="action-item delete">
                                                                <a href="/tweet/<%= tweets[i].tweet_id %>"
                                                                    class="text-secondary text-decoration-none">
                                                                    <svg viewBox="0 0 16 16" width="18" height="18"
                                                                        fill="currentColor">
                                                                        <path
                                                                            d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1H2.5zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5zM8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5zm3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0z" />
                                                                    </svg>
                                                                </a>
                                                            </div>
                                                        </div>

                                                        <p class="card-text mb-2 mt-1 content text-break fs-6 fs-md-5">
                                                            <%= tweets[i].content %>
                                                        </p>

                                                        <!-- Media Path -->
                                                        <% if (tweets[i].media_path) { %>
                                                            <div class="mt-2">
                                                                <img src="/<%= tweets[i].media_path %>"
                                                                    class="img-fluid rounded-4 border border-secondary"
                                                                    alt="Tweet Image">
                                                            </div>
                                                            <% } %>

                                                                <!-- Engagement Actions -->
                                                                <div class="tweet-actions d-flex justify-content-between text-secondary mt-3 w-100 "
                                                                    style="max-width: 425px;">
                                                                    <!-- Reply -->
                                                                    <span class="action-item reply" title="Reply">
                                                                        <i class="far fa-comment comment"
                                                                            tweet_id="<%= tweets[i].tweet_id%>"></i>
                                                                            <%= tweets[i].commentcount%>
                                                                    </span>
                                                                    <!-- Retweet -->
                                                                    <span class="action-item " title="Retweet">
                                                                        <i class="fas fa-retweet retweet"
                                                                            tweet_id="<%= tweets[i].tweet_id%>"></i>
                                                                            <%= tweets[i].retweetcounts%>
                                                                    </span>
                                                                    <!-- Like -->
                                                                 <span class="action-item" title="Like">
    <i class="like <%= tweets[i].islikedbyUser ? 'fas liked' : 'far' %> fa-heart"
       tweet_id="<%= tweets[i].tweet_id %>"></i>
    <span class="like-count"><%= tweets[i].likes %></span>
</span>

                                                                </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>


                                            <% } else { %>

                                                <div class="p-5 text-center">
                                                    <h4 class="fw-bold">You haven't post any Tweet</h4>
                                                    <p class="text-secondary">When you do, they’ll be listed here.</p>
                                                </div>

                                                <% } %>
            </div>
        </div>
    </div>
    <div class="mobileview">
        <%- include('mobile.ejs') %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    <script src="/js/comments.js"></script>
    <script src="/js/likes.js"></script>
    <script src="/js/retweet.js"></script>
    <script src="/js/timezone.js"></script>

</body>

</html>