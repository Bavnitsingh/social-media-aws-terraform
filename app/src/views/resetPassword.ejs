<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password | X</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="bg-black text-white">

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card bg-black border border-secondary p-4 rounded-4" style="max-width: 450px; width: 100%;">
        
        <div class="text-center mb-4 fs-1">&#x1D54F;</div>

        <h3 class="text-white fw-bold mb-4">Reset your password</h3>

        <form action="/reset/<%= token %>" method="post" id="resetPasswordForm">
            
            <!-- New Password -->
            <div class="form-floating mb-3">
                <input type="password" name="password" class="form-control bg-black text-white border-secondary shadow-none" id="password" placeholder="New Password" required>
                <label for="password" class="text-secondary">New Password</label>
            </div>

            <!-- Confirm Password -->
            <div class="form-floating mb-4">
                <input type="password" name="cnfmpassword" class="form-control bg-black text-white border-secondary shadow-none" id="cnfmpassword" placeholder="Confirm Password" required>
                <label for="cnfmpassword" class="text-secondary">Confirm Password</label>
            </div>

            <input type="text" name="email" value="<%= email %>" hidden>

            <div class="mb-4">
                <div id="captcha-container" class="bg-white rounded-3 mb-3 p-2 d-flex justify-content-center overflow-hidden">
                </div>
                
                <input name="captchaId" type="hidden" />
                
                <div class="form-floating">
                    <input name="captchaAns" type="text" class="form-control bg-black text-white border-secondary shadow-none" id="captchaAns" placeholder="Enter characters" required>
                    <label for="captchaAns" class="text-secondary">Enter characters</label>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-light w-100 rounded-pill fw-bold py-2 mt-2">
                Update Password
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="/login" class="text-decoration-none text-primary small">Back to login</a>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

<script>
    async function loadCaptcha() {
        const resp = await fetch("/captcha");
        const { id, svg } = await resp.json();
        document.getElementById("captcha-container").innerHTML = svg;
        document.querySelector('input[name="captchaId"]').value = id;
    }

    let form = document.getElementById("resetPasswordForm");
    form.addEventListener("submit", async (e) => {
        e.preventDefault(); // Prevent default browser refresh
        const resp = await fetch(form.action, {
            method: "POST",
            body: new URLSearchParams(new FormData(form)), // Better for standard post controllers
        });

        if (resp.ok) {
            window.location.href = "/login";
        } else {
            const txt = await resp.text();
            alert(txt);
            await loadCaptcha();
        }
    });

    document.addEventListener("DOMContentLoaded", loadCaptcha);

    setInterval(loadCaptcha, 60000);
</script>

</body>
</html>
