<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login / X</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="bg-black text-white">

    <div class="container d-flex flex-column align-items-center justify-content-center min-vh-100">
        
        <!-- X Logo -->
        <div class="mb-4">
            <a href="/home" class="text-white text-decoration-none display-4 fw-bold">&#x1D54F;</a>
        </div>

        <div class="w-100" style="max-width: 360px;">
            <h2 class="fw-bold mb-4 text-center">Login to X</h2>

            <form action="/login" method="post" id="loginForm">
                
                <!-- Email Input -->
                <div class="mb-3">
                    <input type="text" name="email" id="email" placeholder="Email" 
                        class="form-control bg-black text-white border-secondary py-3 px-3 shadow-none" required/>
                </div>

                <!-- Password Input with Toggle -->
                <div class="mb-2 position-relative">
                    <input type="password" name="password" id="password" placeholder="Password" 
                        class="form-control bg-black text-white border-secondary py-3 px-3 shadow-none" required/>
                    <span id="togglePasswordVisibility" 
                        class="position-absolute end-0 top-50 translate-middle-y me-3 text-secondary" 
                        style="cursor: pointer;">👁️</span>
                </div>

                <div class="mb-4 text-end">
                    <a href="/forgot" class="text-info text-decoration-none small">Forgot password?</a>
                </div>

                <!-- Captcha Section -->
                <div class="mb-4 border border-secondary p-3 rounded-3">
                    <label class="small text-secondary mb-2 d-block text-center">Security Verification</label>
                    <div id="captcha-container" class="mb-2 text-center bg-white rounded py-2">
                        <!-- SVG loads here -->
                    </div>
                    <input name="captchaId" type="hidden" />
                    <input name="captchaAns" type="text" required placeholder="Enter characters" 
                        class="form-control bg-black text-white border-secondary shadow-none" />
                </div>

                <!-- Remember Me -->
                <div class="form-check mb-4">
                    <input class="form-check-input bg-black border-secondary shadow-none" type="checkbox" name="rememberMe" id="rememberMe" value="true">
                    <label class="form-check-label text-secondary small" for="rememberMe">Remember me</label>
                </div>

                <!-- Submit Button (Pill shaped) -->
                <button type="submit" class="btn btn-light w-100 rounded-pill py-2 fw-bold mb-4">Log in</button>
            </form>

            <div class="text-center text-secondary small">
                Don't have an account? 
                <a href="/" class="text-info text-decoration-none">Sign up</a>
            </div>
        </div>
    </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script>
        async function loadCaptcha() {
            const resp = await fetch("/captcha");
            const { id, svg } = await resp.json();
            document.getElementById("captcha-container").innerHTML = svg;
            document.querySelector('input[name="captchaId"]').value = id;
        }

        document.addEventListener('DOMContentLoaded', loadCaptcha);

        const togglebtn = document.getElementById('togglePasswordVisibility');
        const passwordInput = document.getElementById('password');
        togglebtn.addEventListener('click', () => {
            passwordInput.type = passwordInput.type === 'password' ? 'text' : 'password';
        });
    </script>
</body>
</html>
