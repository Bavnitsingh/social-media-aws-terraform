<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-black text-white">

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card bg-black border border-secondary p-4 rounded-4" style="max-width: 450px; width: 100%;">
        
        <div class="text-center mb-4 fs-1 text-white">&#x1D54F;</div>

        <h3 class="fw-bold mb-2 text-white">Find your X account</h3>
        <p class="text-secondary small mb-4">
            If you were redirected here, your password has expired. Enter your email to reset it.
        </p>

        <form action="/forgot" method="post">
            <!-- Email Input -->
            <div class="form-floating mb-3">
                <input type="email" name="email" class="form-control bg-black text-white border-secondary shadow-none" id="email" placeholder="name@example.com" required>
                <label for="email" class="text-secondary">Email</label>
            </div>

            <!-- Captcha Section -->
            <div class="mb-4">
                <div id="captcha-container" class="bg-white rounded-3 mb-3 p-2 d-flex justify-content-center overflow-hidden">
                    <!-- SVG loads here -->
                </div>
                
                <input name="captchaId" type="hidden" />
                
                <div class="form-floating">
                    <input name="captchaAns" type="text" class="form-control bg-black text-white border-secondary shadow-none" id="captchaAns" placeholder="Characters" required>
                    <label for="captchaAns" class="text-secondary">Enter characters</label>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-light w-100 rounded-pill fw-bold py-2 mt-2">
                Submit
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="/login" class="text-decoration-none text-primary small">Cancel</a>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

<script>
    async function loadCaptcha() {
        const resp = await fetch("/captcha");
        const { id, svg } = await resp.json();
        document.getElementById("captcha-container").innerHTML = svg;
        document.querySelector('input[name="captchaId"]').value = id;
    }
    loadCaptcha();
</script>

</body>
</html>
