<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

</head>

<body>

 <div class="container-fluid bg-black min-vh-100 py-3">
    <div class="row justify-content-center">


    <div class="col-2 col-md-3 d-none d-sm-block">
                            <%- include('navbar.ejs') %>
            </div>

    <div class="col-12 col-sm-10 col-md-5 border-start border-end">  
          
    <div class="position-relative">
        <div style="height: 200px; background-color: #333;">
            <img src="/<%= result.cover_pic_path%>" class="w-100 h-100 object-fit-cover" alt="Cover">
        </div>

        <!-- Profile Pic (Positioned Absolute) -->
        <div class="position-absolute start-0 translate-middle-y ps-3" style="top: 100%;">
            <img src="/<%= result.profile_path%>" 
                 class="rounded-circle border border-4 border-black bg-black" 
                 style="width: 130px; height: 130px; object-fit: cover;" 
                 alt="Profile">
        </div>
    </div>

    <!-- Edit Profile Button -->
    <div class="d-flex justify-content-end p-3">
        <button class="btn btn-outline-light rounded-pill fw-bold px-4" data-bs-toggle="modal" data-bs-target="#editProfileModal"> Edit profile</button> &nbsp;&nbsp;
        <button class="btn btn-outline-light rounded-pill fw-bold px-4" onclick="window.location.href='/changePassword'"> Change Password</button>
    </div>






<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-black border border-secondary text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Edit Profile</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="/profile" method="post" enctype="multipart/form-data" id="profileForm">
                    
                    <div class="mb-3">
                        <label class="form-label text-secondary small">First Name</label>
                        <input type="text" name="first_name" class="form-control bg-transparent text-white border-secondary" value="<%= result.first_name %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">Last Name</label>
                        <input type="text" name="last_name" class="form-control bg-transparent text-white border-secondary" value="<%= result.last_name %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">Bio</label>
                        <textarea name="bio" class="form-control bg-transparent text-white border-secondary" rows="3"><%= result.bio %></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">Profile Picture</label>
                        <input type="file" name="profile_pic" class="form-control bg-dark text-white border-secondary" accept="image/*">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">Cover Picture</label>
                        <input type="file" name="cover_pic" class="form-control bg-dark text-white border-secondary" accept="image/*">
                    </div>

                    <div class="modal-footer border-0 p-0 mt-4">
                        <button type="submit" class="btn btn-white bg-white text-black rounded-pill fw-bold w-100">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



    <!-- Profile Info (Optional but recommended) -->
    <div class="mt-4 px-3 border-bottom border-secondary">
        <h4 class="fw-bold mb-0"><%= result.first_name %> <%= result.last_name %></h4>
        <p class="text-secondary"><%= result.user_name %></p>
        <h6 class="text-secondary"><%= result.bio %></h6>
        <h6 class="text-secondary"> Joined at <%= result.created_at.toLocaleDateString()%> </h6>
         <p class="text-secondary"> <b class="text-white"> <%= followerscount %> </b>Followers  &nbsp; <b class="text-white"> <%= followingcount %> </b>Following</p>
      
    </div>

   
    
</div>

            


      <div class="col-md-3 d-none d-md-block">   <%- include('searchbar.ejs',{people:people}) %>

        </div>
    </div>
</div>
    <div class="mobileview">
        <%- include('mobile.ejs') %>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    <script src="/js/profilevalidation.js">

    </script>
    <script src="/js/search.js"></script>
    <script src="/js/follow.js"></script>

</body>

</html>