<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

</head>

<body>

 <div class="container-fluid bg-black min-vh-100 py-3">
    <div class="row justify-content-center">


  <div class="col-2 border-end border-secondary p-0 sticky-top vh-100">
            <%- include('navbar.ejs') %>
        </div>

          <div class="col-5 p-0 text-white">
    <!-- Cover Pic -->
    <div class="position-relative">
        <div style="height: 200px; background-color: #333;">
            <img src="/<%= result.cover_pic_path%>" class="w-100 h-100 object-fit-cover" alt="Cover">
        </div>

        <!-- Profile Pic (Positioned Absolute) -->
        <div class="position-absolute start-0 translate-middle-y ps-3" style="top: 100%;">
            <img src="/<%= result.profile_path%>" 
                 class="rounded-circle border border-4 border-black bg-black" 
                 style="width: 130px; height: 130px; object-fit: cover;" 
                 alt="Profile">
        </div>
    </div>

  




<div class="d-flex justify-content-end p-4">
    </div>

  



    <!-- Profile Info (Optional but recommended) -->
    <div class="mt-4 px-3 border-bottom border-secondary">
        <h4 class="fw-bold mb-0"><%= result.first_name %> <%= result.last_name %></h4>
        <p class="text-secondary"><%= result.user_name %></p>
        <h6 class="text-secondary"><%= result.bio %></h6>
        <h6 class="text-secondary"> Joined at <%= result.created_at.toLocaleDateString()%> </h6>
         <p class="text-secondary"> <b class="text-white"> <%= followerscount %> </b>Followers  &nbsp; <b class="text-white"> <%= followingcount %> </b>Following</p>
      
    </div>

   
    
</div>

            


        <div class="col-3 border-start border-secondary">
 <%- include('searchbar.ejs',{people:people}) %>

        </div>
    </div>
</div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    <script src="/js/profilevalidation.js">

    </script>
</body>

</html>