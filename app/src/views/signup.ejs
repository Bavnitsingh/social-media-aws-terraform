<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-black text-white" data-bs-theme="dark">

<div class="container d-flex flex-column align-items-center py-5 min-vh-100">
    
    <div class="mb-4">
        <a href="/home" class="text-white text-decoration-none display-5 fw-bold">&#x1D54F;</a>
    </div>

    <div class="w-100" style="max-width: 400px;">
        <h2 class="fw-bold mb-4 text-center">Create your account</h2>

        <form action="/" method="post" id="signupForm">
            
            <div class="row g-2 mb-3">
                <div class="col">
                    <input type="text" name="first_name" class="form-control py-3 border-secondary shadow-none" placeholder="First Name" required>
                </div>
                <div class="col">
                    <input type="text" name="last_name" class="form-control py-3 border-secondary shadow-none" placeholder="Last Name" required>
                </div>
            </div>

            <div class="mb-3">
                <input type="text" name="phone_number" class="form-control py-3 border-secondary shadow-none" placeholder="Phone Number">
            </div>

                <input type="hidden" name="timezone" id="user-timezone">
            <div class="mb-3">
                <input type="email" name="email" class="form-control py-3 border-secondary shadow-none" placeholder="Email" required>
            </div>

            <div class="mb-3">
                <input type="text" name="user_name" placeholder="Username" class="form-control py-3 border-secondary shadow-none" required>
            </div>

            <div class="mb-2 position-relative">
                <input type="password" name="password" id="password" class="form-control py-3 border-secondary shadow-none" placeholder="Password" required>
                <span id="togglePasswordVisibility" class="position-absolute end-0 top-50 translate-middle-y me-3 text-secondary" style="cursor: pointer;">👁️</span>
            </div>

            <div id="strongPasswordMessage" class="alert alert-dark border-secondary p-2 mb-3 d-none">
                <p class="text-danger m-0 small">• Minimum 8 characters</p>
                <p class="text-danger m-0 small">• 1 capital, 1 small, 1 digit, 1 special char</p>
            </div>

            <div class="mb-4 border border-secondary p-3 rounded-3">
                <div id="captcha-container" class="mb-2 text-center bg-white rounded-2 py-2 overflow-hidden"></div>
                <input name="captchaId" type="hidden">
                <input name="captchaAns" type="text" required placeholder="Enter characters" class="form-control form-control-sm border-secondary shadow-none">
            </div>

            <button type="submit" class="btn btn-light w-100 rounded-pill py-2 fw-bold mb-4">Next</button>
        </form>

        <div class="text-center text-secondary small">
            Already have an account? 
            <a href="/login" class="text-info text-decoration-none">Log in</a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script><script>
    const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;
    const strongPasswordMessage = document.getElementById('strongPasswordMessage');
    const passwordInput = document.getElementById('password');

    passwordInput.addEventListener('input', () => {
        const val = passwordInput.value;
        // Using Bootstrap d-none class for display logic
        if (val === "" || regex.test(val)) {
            strongPasswordMessage.classList.add('d-none');
        } else {
            strongPasswordMessage.classList.remove('d-none');
        }
    });

    async function loadCaptcha() {
        try {
            const resp = await fetch("/captcha");
            const { id, svg } = await resp.json();
            const container = document.getElementById("captcha-container");
            container.innerHTML = svg;
            // Clean up SVG size for bootstrap container
            const svgElement = container.querySelector('svg');
            if(svgElement) { svgElement.style.maxWidth = "200px"; svgElement.style.height = "auto"; }
            document.querySelector('input[name="captchaId"]').value = id;
        } catch (e) { console.error("Captcha error", e); }
    }

    document.addEventListener('DOMContentLoaded', loadCaptcha);

    const form = document.getElementById('signupForm');
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const resp = await fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(new FormData(form))
        });

        if (resp.ok) {
            window.location.href = '/login';
        } else {
            const txt = await resp.text();
            alert(txt);
            await loadCaptcha();
        }
    });

    document.getElementById('togglePasswordVisibility').addEventListener('click', () => {
        passwordInput.type = (passwordInput.type === 'text') ? 'password' : 'text';
    });
</script>
<script>
     document.addEventListener('DOMContentLoaded', () => {
        const detectedTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        
        document.getElementById('user-timezone').value = detectedTimezone;
    });
</script>
</body>
</html>
